# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env a GitHub — está en .gitignore.

# Bot de Telegram
# Obtener token hablando con @BotFather en Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Proveedor de Gemma 4
# Cambiar GEMMA_PROVEEDOR para alternar entre entornos:
#   "google"      → Google AI Studio (requiere GEMINI_API_KEY)
#   "huggingface" → HuggingFace Inference API (requiere HUGGINGFACE_TOKEN)
#   "ollama"      → Ollama en red local (servidor en 192.168.0.135)
GEMMA_PROVEEDOR=google

# Google AI Studio (proveedor por defecto)
# Obtener clave en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Apps Script — endpoint para envío de email
# Desplegar como aplicación web en: https://script.google.com
GAS_EMAIL_URL=

# HuggingFace Inference API (alternativa desarrollo)
# Obtener token en: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=

# Ollama en red local (alternativa producción)
# Servidor Ollama corriendo en la red local con Gemma 4 cargado
OLLAMA_URL=http://192.168.0.135:11434
